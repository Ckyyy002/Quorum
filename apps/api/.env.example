# Copy to apps/api/.env and fill in. Every variable is checked at startup (src/config/env.validation.ts).

PORT=3000
# docker compose maps the dev Postgres to 5434 on the host.
DATABASE_URL=postgresql://quorum:quorum@localhost:5434/quorum
# 32+ characters, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-chars
# Uploaded files, relative to apps/api.
UPLOAD_DIR=uploads

# First admin, created by `pnpm --filter api db:seed` (password 8+ characters).
ADMIN_EMAIL=admin@quorum.test
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin Quorum

# Mail: `smtp` sends to Mailpit in dev (UI http://localhost:8025); `json` only builds the message (tests).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Quorum HMTC <no-reply@quorum.test>
# The web app's address, used for links in emails.
WEB_URL=http://localhost:5173
